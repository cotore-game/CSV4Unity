# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings
/.gitattributes text eol=lf
/.gitignore text eol=lf
*.cs text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.yml text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.sh text eol=lf

# Exclude TextMesh Pro files from language statistics
"Assets/TextMesh Pro/**" linguist-generated=true linguist-vendored=true
